# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Database ────────────────────────────────────────────────────────────────
# Production requires a reachable PostgreSQL database. Set both values in
# Vercel Project Settings > Environment Variables for Production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# ─── Authentication ─────────────────────────────────────────────────────────
# Required in Vercel Production. Use long random values for JWT_SECRET and
# unique credentials for each team role. Never commit real values.
JWT_SECRET="replace-with-a-long-random-secret"
COUNSELOR_USERNAME="counselor"
COUNSELOR_EMAIL="counselor@yourdomain.com"
COUNSELOR_PASSWORD="replace-with-a-strong-password"
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="replace-with-a-different-strong-password"

# ─── Public env vars (safe to expose in browser) ─────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER="+601XXXXXXXXX"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_SITE_NAME="Study Malaysia Portal"
