// Prisma Schema for Study Malaysia Portal
// Production ready with SQLite (local development) and 100% compatible with PostgreSQL (Supabase / Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String        @id @default(cuid())
  email     String        @unique
  name      String
  password  String        // bcrypt hashed
  role      String        @default("COUNSELOR") // 'COUNSELOR' | 'ADMIN'
  active    Boolean       @default(true)
  cases     StudentCase[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model University {
  id                    String    @id @default(cuid())
  slug                  String    @unique
  name                  String
  shortName             String
  type                  String    // 'Public Research' | 'Private Premier' | 'International Branch'
  qsRank                String?
  location              String
  city                  String?
  state                 String?
  image                 String?
  logo                  String?
  tuitionBachelor       String?
  tuitionMaster         String?
  tuitionPhd            String?
  hostelMonthly         String?
  emgsYearly            String?
  avgTuition3Yr         Float?
  registrationDeposit   Float?
  livingCostTier        String?   // 'Low-Mod' | 'Moderate' | 'High'
  livingCostMonthly     Float?
  description           String?
  highlights            String?   // JSON array string
  intakeMonths          String?
  emgsFeeMYR            Float?
  miscFeesMYR           Float?
  totalInitialMYR       Float?
  initialBreakdownNotes String?
  websiteUrl            String?
  featured              Boolean   @default(false)
  programs              Program[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Program {
  id                String             @id @default(cuid())
  slug              String             @unique
  title             String
  universityId      String
  university        University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  degreeLevel       String             // 'Foundation / Diploma' | "Bachelor's Degree" | "Master's (Postgraduate)" | "Ph.D & Doctorate"
  faculty           String
  badgeType         String?            // 'verified' | 'flagship' | 'australian' | 'qs300' | 'topuk'
  badgeText         String?
  duration          String
  durationYears     Float?
  intakeMonths      String             // Comma-separated or JSON
  scholarship       String?
  tuitionMYR        Float
  firstYearFeeMYR   Float?
  secondYearFeeMYR  Float?
  thirdYearFeeMYR   Float?
  fourthYearFeeMYR  Float?
  tuitionUSD        Float?
  emgsFeeMYR        Float?
  miscFeesMYR       Float?
  totalInitialMYR   Float?
  miscBreakdown     String?
  pakistanNotes     String?
  description       String?
  academicReq       String?
  englishReq        String?
  minGpa            String?
  documentsReq      String?            // JSON string array
  featured          Boolean            @default(false)
  semesterSchedules SemesterSchedule[]
  inquiries         Inquiry[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model SemesterSchedule {
  id         String   @id @default(cuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  semester   String
  tuitionMYR Float
  miscMYR    Float
}

model Inquiry {
  id              String   @id @default(cuid())
  studentName     String
  phone           String
  email           String?
  city            String?
  qualification   String?  // 'Matric' | 'FSc / ICS' | 'A-Levels' | 'Bachelor' | 'Master'
  programInterest String?
  programId       String?
  program         Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  status          String   @default("NEW") // 'NEW' | 'CONTACTED' | 'IN_REVIEW' | 'ADMITTED' | 'CLOSED'
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  title     String
  action    String   // 'CREATE' | 'UPDATE' | 'DELETE' | 'BATCH_IMPORT'
  target    String
  user      String   @default("Meezab Admissions Team")
  details   String?
  createdAt DateTime @default(now())
}

model StudentCase {
  id                String            @id @default(cuid())
  studentName       String
  passportNumber    String?
  phone             String
  email             String?
  city              String?
  
  // Counselor assigned (from User model or custom name)
  counselorId       String?
  counselorName     String?
  counselor         User?             @relation(fields: [counselorId], references: [id], onDelete: SetNull)
  
  // Branch origin / handling
  branch            String            @default("Lahore (Head Office)")
  
  // Academic target
  targetUniversity  String
  targetProgram     String
  intake            String
  degreeLevel       String?
  
  // Overall Case Status
  // 'NEW' | 'DOCS_PENDING' | 'DOCS_RECEIVED' | 'APPLICATION_SUBMITTED' | 'OFFER_LETTER_RECEIVED' | 'EMGS_PENDING' | 'EMGS_PAID' | 'VAL_IN_PROCESS' | 'VAL_ISSUED' | 'VISA_APPLIED' | 'VISA_RECEIVED' | 'CASE_CLOSED' | 'DROPPED_REJECTED'
  status            String            @default("APPLICATION_SUBMITTED")
  
  // Detailed milestone checks
  offerLetterStatus String?           // 'PENDING' | 'CONDITIONAL' | 'UNCONDITIONAL'
  
  emgsPaid          Boolean           @default(false)
  emgsPaymentDate   DateTime?
  emgsRefNumber     String?
  
  valPercentage     Int?              @default(0) // 0, 15, 35, 70, 80, 100
  valStatus         String?           // 'NOT_APPLIED' | 'IN_PROCESS' | 'VAL_ISSUED' | 'VAL_REJECTED'
  valIssuedDate     DateTime?
  
  visaStatus        String?           // 'NOT_APPLIED' | 'SEV_APPLIED' | 'VISA_STICKER' | 'EVISA_RECEIVED'
  visaDate          DateTime?
  
  travelDate        DateTime?
  caseClosedDate    DateTime?
  bookingDone       Boolean           @default(true) // Case closed / booking started by counselor
  reachedMalaysia   Boolean           @default(false) // Final process completed / reached Malaysia
  
  notes             String?
  
  referrals         BranchReferral[]
  timelineLogs      CaseTimelineLog[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model TrackedCounselor {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String?
  phone     String?
  branch    String   @default("Lahore (Head Office)")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BranchReferral {
  id              String      @id @default(cuid())
  caseId          String
  studentCase     StudentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromBranch      String
  toBranch        String
  referredBy      String      // Counselor or Staff name
  handledBy       String?     // Staff at receiving branch
  reason          String?
  status          String      @default("TRANSFERRED") // 'PENDING' | 'TRANSFERRED' | 'COMPLETED'
  transferDate    DateTime    @default(now())
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model CaseTimelineLog {
  id          String      @id @default(cuid())
  caseId      String
  studentCase StudentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  action      String      // 'STATUS_CHANGE' | 'EMGS_UPDATE' | 'VAL_UPDATE' | 'VISA_UPDATE' | 'REFERRAL' | 'NOTE'
  title       String
  details     String?
  performedBy String      @default("Admin")
  createdAt   DateTime    @default(now())
}

model DirectPanelUniversity {
  id                String   @id @default(cuid())
  name              String   @unique
  shortName         String?
  contractType      String   @default("Direct Agreement") // 'Direct Agreement' | 'Preferred Tier-1' | 'Official Representative' | 'Govt MoA'
  contractStatus    String   @default("Active") // 'Active' | 'Under Renewal' | 'Review'
  directPortalUrl   String?
  focalPersonName   String?
  focalPersonEmail  String?
  focalPersonPhone  String?
  supportedIntakes  String?  // e.g. "Feb, July, Sept, Nov"
  specialNotes      String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}



