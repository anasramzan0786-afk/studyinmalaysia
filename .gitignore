# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/

# Environment variables (NEVER commit real secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database files (local SQLite — not for version control)
prisma/*.db
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal

# Prisma generated client (auto-generated on install)
# node_modules/@prisma/client is already covered above

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor directories
.vscode/
.idea/
*.swp
*.swo

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Legacy backup (archived Vite files — optional to include)
legacy_backup/
